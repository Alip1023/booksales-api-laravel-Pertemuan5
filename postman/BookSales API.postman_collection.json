{
  "info": {
    "_postman_id": "c0b9a440-519b-47ea-9c8b-25e747d84069",
    "name": "BookSales API",
    "description": "Smoke tests berurutan untuk API penulis dan buku.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "authorId",
      "value": ""
    },
    {
      "key": "bookId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create author",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Author {{$guid}}\",\n  \"email\": \"postman-{{$guid}}@example.test\",\n  \"bio\": \"Created by the Postman collection\"\n}"
        },
        "url": "{{baseUrl}}/api/authors"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('author created', function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set('authorId', pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "List authors",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/authors"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('authors listed', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().data).to.be.an('array'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Show author",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/authors/{{authorId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('author returned', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().data.id).to.eql(Number(pm.collectionVariables.get('authorId'))); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Update author",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bio\": \"Updated by the Postman collection\"\n}"
        },
        "url": "{{baseUrl}}/api/authors/{{authorId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('author updated', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().data.bio).to.eql('Updated by the Postman collection'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Create book",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"author_id\": {{authorId}},\n  \"title\": \"Postman Book {{$guid}}\",\n  \"description\": \"Created by the Postman collection\",\n  \"price\": 85000,\n  \"stock\": 12\n}"
        },
        "url": "{{baseUrl}}/api/books"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('book created', function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set('bookId', pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "List books",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/books"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('books listed', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().data).to.be.an('array'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Show book",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/books/{{bookId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('book returned', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().data.id).to.eql(Number(pm.collectionVariables.get('bookId'))); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Update book",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"stock\": 20\n}"
        },
        "url": "{{baseUrl}}/api/books/{{bookId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('book updated', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().data.stock).to.eql(20); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete book",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/books/{{bookId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('book deleted', function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete author",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/authors/{{authorId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('author deleted', function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    }
  ]
}
